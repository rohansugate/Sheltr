# Appwrite — Console → Overview / API keys
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://<REGION>.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=

# Optional — unlock Zillow (blocks direct requests)
BRIGHT_DATA_API_TOKEN=
BRIGHT_DATA_UNLOCKER_ZONE=web_unlocker1

# Demo / hackathon mode (optional)
ALLOW_DEMO_BYPASS=true
NEXT_PUBLIC_ALLOW_DEMO_BYPASS=true

# Shared demo room (/api/demo/sync) only runs when demo bypass is on.
# Turn both flags off in production so all data goes through Appwrite.
# SHELTR_DEMO_ROOM=doorway-hackathon
